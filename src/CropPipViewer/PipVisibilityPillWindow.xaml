<Window x:Class="CropPipViewer.PipVisibilityPillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PIP Visibility Pill" Width="76" Height="20"
        MinWidth="76" MaxWidth="76" MinHeight="20" MaxHeight="20"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        SizeToContent="Manual" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Border x:Name="PillBorder"
            CornerRadius="10"
            Background="#2f6f54"
            BorderBrush="#184a35"
            BorderThickness="1"
            Padding="6,0"
            Cursor="SizeAll"
            MouseLeftButtonDown="Pill_MouseLeftButtonDown"
            MouseMove="Pill_MouseMove"
            MouseLeftButtonUp="Pill_MouseLeftButtonUp"
            MouseRightButtonUp="Pill_MouseRightButtonUp">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Ellipse x:Name="StatusDot"
                     Width="4" Height="4"
                     Fill="#7dffc0"
                     Margin="0,0,4,0"
                     VerticalAlignment="Center"/>
            <TextBlock x:Name="StateText"
                       Grid.Column="1"
                       Text="PIP ON"
                       Foreground="White"
                       FontSize="9"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       TextWrapping="NoWrap"/>
        </Grid>
    </Border>
</Window>
