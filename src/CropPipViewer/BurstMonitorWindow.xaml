<Window x:Class="CropPipViewer.BurstMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Burst Monitor" Width="188" Height="74"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        SizeToContent="Manual">
    <Border x:Name="RootBorder"
            CornerRadius="9"
            Background="#2e101820"
            BorderBrush="#66d9ff"
            BorderThickness="1"
            Padding="7"
            Cursor="SizeAll"
            MouseLeftButtonDown="Root_MouseLeftButtonDown"
            MouseMove="Root_MouseMove"
            MouseLeftButtonUp="Root_MouseLeftButtonUp">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="18"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="18"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42"/>
                <ColumnDefinition Width="62"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="준" Foreground="#c7e8ff" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
            <TextBlock x:Name="SemiTimeText" Grid.Row="0" Grid.Column="1" Text="--" Foreground="White" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
            <Border x:Name="SemiStateBorder" Grid.Row="0" Grid.Column="2" CornerRadius="7" Background="#455363" Padding="4,0" Margin="2,1">
                <TextBlock x:Name="SemiStateText" Text="대기" Foreground="White" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="극" Foreground="#c7e8ff" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
            <TextBlock x:Name="BurstTimeText" Grid.Row="1" Grid.Column="1" Text="--" Foreground="White" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
            <Border x:Name="BurstStateBorder" Grid.Row="1" Grid.Column="2" CornerRadius="7" Background="#455363" Padding="4,0" Margin="2,1">
                <TextBlock x:Name="BurstStateText" Text="대기" Foreground="White" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="오" Foreground="#c7e8ff" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
            <TextBlock x:Name="OriginTimeText" Grid.Row="2" Grid.Column="1" Text="--" Foreground="White" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
            <Border x:Name="OriginStateBorder" Grid.Row="2" Grid.Column="2" CornerRadius="7" Background="#455363" Padding="4,0" Margin="2,1">
                <TextBlock x:Name="OriginStateText" Text="대기" Foreground="White" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

        </Grid>
    </Border>
</Window>
