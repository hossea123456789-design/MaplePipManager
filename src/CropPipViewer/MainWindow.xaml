<Window x:Class="CropPipViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crop PiP Viewer v33c - Per-PIP Crop Opacity" Height="760" Width="1120" MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/AppIcon.ico">
    <Window.Resources>
        <Style x:Key="SectionBorder" TargetType="Border">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="TinyLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="OptionCheck" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,12,8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="24"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,8,6"/>
        </Style>
        <DataTemplate x:Key="BorderPaletteItemTemplate">
            <StackPanel Orientation="Horizontal">
                <Border Width="16" Height="16" CornerRadius="3" BorderBrush="#666" BorderThickness="1" Margin="0,0,6,0" Background="{Binding Brush}"/>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource SectionBorder}" Background="#101820" BorderBrush="#344">
            <DockPanel LastChildFill="True">
                <TextBlock Text="대상 창" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,6" DockPanel.Dock="Left"/>
                <WrapPanel>
                    <ComboBox x:Name="WindowCombo" MinWidth="360" Width="420" Height="30" DisplayMemberPath="Title" Margin="0,0,8,6"/>
                    <Button Content="새로고침" Width="80" Style="{StaticResource SmallButton}" Click="RefreshWindows_Click"/>
                    <Button Content="대상 선택" Width="90" Style="{StaticResource SmallButton}" Click="SelectTarget_Click"/>
                    <Button Content="PiP 표시/숨김" Width="110" Style="{StaticResource SmallButton}" Click="ToggleOverlay_Click"/>
                    <Button Content="필터키만 표시" Width="105" Style="{StaticResource SmallButton}" Click="ShowFilterKeysPillOnly_Click" ToolTip="일반 PIP는 숨기고 필터키 알약 PIP 버튼만 표시합니다."/>
                </WrapPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource SectionBorder}" Background="#fff8e8" BorderBrush="#e2c980">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="프리셋" FontWeight="SemiBold" Style="{StaticResource TinyLabel}"/>
                <ComboBox x:Name="PresetCombo" Width="190" Height="28" DisplayMemberPath="DisplayName" SelectionChanged="PresetCombo_SelectionChanged" Margin="0,0,12,6"/>
                <TextBlock Text="이름" Style="{StaticResource TinyLabel}"/>
                <TextBox x:Name="PresetNameBox" Width="170" Height="28" MaxLength="30" VerticalContentAlignment="Center" Margin="0,0,8,6"/>
                <Button Content="이름 저장" Width="80" Style="{StaticResource SmallButton}" Click="SavePresetName_Click"/>
                <Button Content="현재 설정 저장" Width="105" Style="{StaticResource SmallButton}" Click="SaveCurrentPreset_Click" ToolTip="현재 크롭/PIP 배치/분리 상태/투명도/갱신 속도를 현재 프리셋 슬롯에 저장합니다."/>
                <TextBlock Text="프리셋은 최대 6개. 선택 시 현재 슬롯 저장 후 선택 슬롯을 불러옵니다." Foreground="#6d5b24" VerticalAlignment="Center" Margin="4,0,0,6"/>
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="390"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,10,0">
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button Content="크롭 추가" Width="100" Style="{StaticResource SmallButton}" Click="AddCrop_Click"/>
                    <Button Content="선택 삭제" Width="100" Style="{StaticResource SmallButton}" Click="DeleteCrop_Click"/>
                    <Button Content="로그 폴더" Width="90" Style="{StaticResource SmallButton}" Click="OpenLogFolder_Click"/>
                    <TextBlock Text="크롭 더블클릭=편집 / 우클릭=복사·붙여넣기 / Shift=다중 선택" Foreground="#666" VerticalAlignment="Center" Margin="4,0,0,6"/>
                </WrapPanel>

                <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="10" Background="#f7fbff" BorderBrush="#c9dceb" BorderThickness="1" CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="크롭 테두리 스타일" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <WrapPanel Margin="0,0,0,6">
                            <TextBlock Text="적용 대상" Style="{StaticResource TinyLabel}"/>
                            <TextBlock x:Name="CropBorderSelectionText" Text="선택 없음" VerticalAlignment="Center" Foreground="#456" Margin="0,0,12,0"/>
                            <Button x:Name="CopyCropBorderStyleButton" Content="스타일 복사" Width="88" Style="{StaticResource SmallButton}" Click="CopyCropBorderStyle_Click"/>
                            <Button x:Name="PasteCropBorderStyleButton" Content="스타일 붙여넣기" Width="98" Style="{StaticResource SmallButton}" Click="PasteCropBorderStyle_Click"/>
                        </WrapPanel>
                        <WrapPanel>
                            <TextBlock Text="색상" Style="{StaticResource TinyLabel}"/>
                            <ComboBox x:Name="CropBorderColorCombo" Width="180" Height="28" ItemTemplate="{StaticResource BorderPaletteItemTemplate}" SelectionChanged="CropBorderColorCombo_SelectionChanged" Margin="0,0,12,6"/>
                            <TextBlock Text="테두리 투명도" Style="{StaticResource TinyLabel}"/>
                            <Slider x:Name="CropBorderOpacitySlider" Width="140" Height="24" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="False" SmallChange="0.01" LargeChange="0.1" ValueChanged="CropBorderOpacitySlider_ValueChanged" Margin="0,0,6,6"/>
                            <TextBlock x:Name="CropBorderOpacityValueText" Text="0%" VerticalAlignment="Center" Width="42" Margin="0,0,12,6"/>
                            <Button Content="0%" Width="46" Style="{StaticResource SmallButton}" Click="CropBorderOpacityZero_Click"/>
                            <Button Content="25%" Width="50" Style="{StaticResource SmallButton}" Click="CropBorderOpacity25_Click"/>
                            <Button Content="50%" Width="50" Style="{StaticResource SmallButton}" Click="CropBorderOpacity50_Click"/>
                            <Button Content="75%" Width="50" Style="{StaticResource SmallButton}" Click="CropBorderOpacity75_Click"/>
                            <Button Content="100%" Width="56" Style="{StaticResource SmallButton}" Click="CropBorderOpacity100_Click"/>
                        </WrapPanel>
                        <TextBlock Text="선택한 크롭에 즉시 적용됩니다. 색상은 PiP 창 테두리가 아니라 크롭 영역 자체에 그려집니다." Foreground="#567" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <DataGrid x:Name="CropGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          IsReadOnly="False"
                          RowHeight="64"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          MouseDoubleClick="CropGrid_MouseDoubleClick"
                          MouseRightButtonDown="CropGrid_MouseRightButtonDown"
                          CurrentCellChanged="CropGrid_CurrentCellChanged"
                          SelectionChanged="CropGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="사용" Binding="{Binding Enabled}" Width="50"/>
                        <DataGridTemplateColumn Header="미리보기" Width="104" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Width="92" Height="52" Background="#151515" BorderBrush="#444" BorderThickness="1" CornerRadius="4" Padding="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="LowQuality"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="이름" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
                        <DataGridTextColumn Header="소속 PIP" Binding="{Binding PipLabel}" Width="90" IsReadOnly="True"/>
                        <DataGridTextColumn Header="극딜 역할" Binding="{Binding BurstRoleName}" Width="80" IsReadOnly="True"/>
                        <DataGridTextColumn Header="X" Binding="{Binding X}" Width="60" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Y" Binding="{Binding Y}" Width="60" IsReadOnly="True"/>
                        <DataGridTextColumn Header="W" Binding="{Binding Width}" Width="60" IsReadOnly="True"/>
                        <DataGridTextColumn Header="H" Binding="{Binding Height}" Width="60" IsReadOnly="True"/>
                        <DataGridTextColumn Header="형태" Binding="{Binding ShapeName}" Width="80" IsReadOnly="True"/>
                        <DataGridTextColumn Header="PiP X" Binding="{Binding DisplayX, UpdateSourceTrigger=PropertyChanged, StringFormat=0}" Width="70"/>
                        <DataGridTextColumn Header="PiP Y" Binding="{Binding DisplayY, UpdateSourceTrigger=PropertyChanged, StringFormat=0}" Width="70"/>
                        <DataGridTextColumn Header="표시 W" Binding="{Binding DisplayWidth, UpdateSourceTrigger=PropertyChanged, StringFormat=0}" Width="80"/>
                        <DataGridTextColumn Header="표시 H" Binding="{Binding DisplayHeight, UpdateSourceTrigger=PropertyChanged, StringFormat=0}" Width="80"/>
                        <DataGridTextColumn Header="회전°" Binding="{Binding RotationAngle, UpdateSourceTrigger=PropertyChanged, StringFormat=0.##}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>


            </DockPanel>

            <TabControl Grid.Column="1">
                <TabItem Header="PIP">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10">
                            <Border Background="#eef7ff" BorderBrush="#9cc7e7" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,12">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <Border x:Name="ResolutionMatchBadgeBorder" DockPanel.Dock="Right" Background="#748294" CornerRadius="9" Padding="8,2" Margin="8,0,0,0">
                                            <TextBlock x:Name="ResolutionMatchBadgeText" Text="미연결" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                        <TextBlock Text="메이플 해상도 기준 매칭" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <Border Background="White" BorderBrush="#c9dceb" BorderThickness="1" CornerRadius="5" Padding="7" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="72"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="현재 연결" Foreground="#456" Margin="0,0,8,3"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="CurrentMapleResolutionText" Text="미선택" FontWeight="SemiBold" TextWrapping="NoWrap" Margin="0,0,0,3"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="최초 저장" Foreground="#456" Margin="0,0,8,0"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ActivePresetResolutionText" Text="미저장" FontWeight="SemiBold" TextWrapping="NoWrap"/>
                                        </Grid>
                                    </Border>

                                    <TextBlock Text="프리셋별 최초 저장 해상도" FontWeight="SemiBold" Foreground="#345" Margin="0,0,0,5"/>
                                    <UniformGrid Columns="2" Rows="3">
                                        <Border Background="White" BorderBrush="#c9dceb" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,5,5">
                                            <TextBlock x:Name="PresetResolutionP1Text" Text="P1  미저장" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                        <Border Background="White" BorderBrush="#c9dceb" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,5">
                                            <TextBlock x:Name="PresetResolutionP2Text" Text="P2  미저장" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                        <Border Background="White" BorderBrush="#c9dceb" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,5,5">
                                            <TextBlock x:Name="PresetResolutionP3Text" Text="P3  미저장" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                        <Border Background="White" BorderBrush="#c9dceb" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,5">
                                            <TextBlock x:Name="PresetResolutionP4Text" Text="P4  미저장" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                        <Border Background="White" BorderBrush="#c9dceb" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,5,0">
                                            <TextBlock x:Name="PresetResolutionP5Text" Text="P5  미저장" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                        <Border Background="White" BorderBrush="#c9dceb" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,0">
                                            <TextBlock x:Name="PresetResolutionP6Text" Text="P6  미저장" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        </Border>
                                    </UniformGrid>
                                    <Button Content="현재 연결 해상도로 기준 다시 저장" Height="28" Margin="0,4,0,0"
                                            Click="ResetPresetResolutionBaseline_Click"
                                            ToolTip="현재 프리셋의 기준 해상도를 지금 연결된 메이플 WGC 해상도로 강제로 다시 저장합니다. 평소에는 ‘현재 설정 저장’의 최초 저장값이 유지됩니다."/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="PIP 선택" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ComboBox x:Name="PipSelectCombo" Height="28" DisplayMemberPath="Name" SelectionChanged="PipSelectCombo_SelectionChanged" Margin="0,0,0,10"/>

                            <TextBlock Text="선택 PIP 크롭 투명도" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock x:Name="OpacityText" Text="92%" Width="45" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <Slider x:Name="OpacitySlider" Minimum="0.05" Maximum="1" Value="0.92" TickFrequency="0.05" IsSnapToTickEnabled="False" SmallChange="0.01" LargeChange="0.05" ValueChanged="OpacitySlider_ValueChanged"/>
                            </DockPanel>
                            <WrapPanel Margin="0,0,0,4">
                                <Button Content="-5%" Width="44" Style="{StaticResource SmallButton}" Click="OpacityMinus5_Click"/>
                                <Button Content="-1%" Width="44" Style="{StaticResource SmallButton}" Click="OpacityMinus1_Click"/>
                                <Button Content="+1%" Width="44" Style="{StaticResource SmallButton}" Click="OpacityPlus1_Click"/>
                                <Button Content="+5%" Width="44" Style="{StaticResource SmallButton}" Click="OpacityPlus5_Click"/>
                            </WrapPanel>
                            <Button Content="크롭 투명도 전체 적용" Height="28" Margin="0,0,0,14" Click="ApplyCropOpacityToAll_Click" ToolTip="현재 선택 PIP의 크롭 투명도를 메인/분리 PIP 전체에 일괄 적용합니다."/>

                            <TextBlock Text="선택 PIP 배경 투명도" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock x:Name="PipBackgroundOpacityText" Text="13%" Width="48" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <Slider x:Name="PipBackgroundOpacitySlider" Minimum="0" Maximum="1" Value="0.13" TickFrequency="0.05" SmallChange="0.01" LargeChange="0.05" ValueChanged="PipBackgroundOpacitySlider_ValueChanged"/>
                            </DockPanel>
                            <Button Content="PIP 배경 전체 적용" Height="28" Margin="0,0,0,14" Click="ApplyPipBackgroundOpacityToAll_Click" ToolTip="현재 PIP 배경 투명도를 메인/분리 PIP 전체에 일괄 적용합니다."/>

                            <TextBlock Text="전체 확대" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock x:Name="ScaleText" Text="100%" Width="55" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <Slider x:Name="ScaleSlider" Minimum="0.25" Maximum="3.0" Value="1.0" TickFrequency="0.05" SmallChange="0.01" LargeChange="0.1" IsSnapToTickEnabled="False" ValueChanged="ScaleSlider_ValueChanged"/>
                            </DockPanel>

                            <UniformGrid Columns="2" Margin="0,0,0,2">
                                <CheckBox x:Name="ResizeItemsWithWindowCheck" Content="창 크기 연동" Style="{StaticResource OptionCheck}" ToolTip="PIP 창 크기 조정 시 내부 크롭 표시도 함께 조정합니다." Checked="OptionChanged" Unchecked="OptionChanged"/>
                                <CheckBox x:Name="TopMostCheck" Content="항상 위" Style="{StaticResource OptionCheck}" IsChecked="True" Checked="OptionChanged" Unchecked="OptionChanged"/>
                                <CheckBox x:Name="ClickThroughCheck" Content="PIP 클릭 무시" Style="{StaticResource OptionCheck}" ToolTip="보스전처럼 PIP를 실수로 선택하거나 움직이면 안 되는 상황에서 사용합니다." Checked="OptionChanged" Unchecked="OptionChanged"/>
                                <CheckBox x:Name="PipPositionLockCheck" Content="PIP 위치 고정" Style="{StaticResource OptionCheck}" ToolTip="현재 PIP 위치를 메이플스토리 클라이언트 좌상단 기준 상대 좌표로 저장하고, 메이플 창 이동 시 함께 따라가게 합니다." Checked="OptionChanged" Unchecked="OptionChanged"/>
                            </UniformGrid>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="성능">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10">
                            <TextBlock Text="PIP 갱신 속도" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ComboBox x:Name="CaptureSpeedCombo" Height="28" SelectionChanged="CaptureSpeedCombo_SelectionChanged" Margin="0,0,0,10">
                                <ComboBoxItem Content="안정 100ms / 10 FPS" Tag="100"/>
                                <ComboBoxItem Content="빠름 40ms / 25 FPS" Tag="40"/>
                                <ComboBoxItem Content="초고속 33ms / 30 FPS" Tag="33"/>
                                <ComboBoxItem Content="극한 16ms / 60 FPS" Tag="16"/>
                            </ComboBox>
                            <UniformGrid Columns="2" Margin="0,0,0,2">
                                <CheckBox x:Name="FrameEventRefreshCheck" Content="프레임 즉시 갱신" Style="{StaticResource OptionCheck}" ToolTip="WGC 프레임이 도착하면 즉시 PIP 갱신을 요청합니다." Checked="CapturePerformanceOptionChanged" Unchecked="CapturePerformanceOptionChanged"/>
                                <CheckBox x:Name="ShowPerformanceStatsCheck" Content="FPS 표시" Style="{StaticResource OptionCheck}" ToolTip="각 PIP 우측 하단에 현재 갱신 FPS와 평균 처리시간을 표시합니다." Checked="CapturePerformanceOptionChanged" Unchecked="CapturePerformanceOptionChanged"/>
                            </UniformGrid>
                            <TextBlock x:Name="CaptureSpeedText" Text="기본 100ms. 보스전 반응성은 33ms 또는 16ms를 테스트하세요." Foreground="#567" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="극딜 감지">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10">
                            <TextBlock Text="스킬 아이콘 역할 지정" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock Text="v30은 밝기/OCR/숫자 판정을 사용하지 않습니다. 각 스킬의 실제 준비 상태와 사용 직후 상태를 직접 학습한 뒤, 두 상태를 분류해 READY → COOLDOWN 전환만 감지합니다." Foreground="#566" TextWrapping="Wrap" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="58"/>
                                    <ColumnDefinition Width="68"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="준극딜" Style="{StaticResource TinyLabel}" Margin="0,0,8,6"/>
                                <ComboBox x:Name="SemiBurstCropCombo" Grid.Row="0" Grid.Column="1" Height="28" DisplayMemberPath="Name" SelectionChanged="BurstRoleCombo_SelectionChanged" Margin="0,0,8,6"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="보정(초)" Style="{StaticResource TinyLabel}" Margin="0,0,6,6" HorizontalAlignment="Right"/>
                                <TextBox x:Name="SemiBurstTimingCorrectionBox" Grid.Row="0" Grid.Column="3" Height="28" Text="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" ToolTip="준극딜 감지 지연 보정. 입력한 초만큼 실제 남은 시간에서 추가 차감합니다. 예: 감지가 항상 약 2초 늦으면 2 입력." LostFocus="BurstMonitorTextBox_LostFocus" KeyDown="BurstMonitorTextBox_KeyDown" Margin="0,0,0,6"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="극딜" Style="{StaticResource TinyLabel}" Margin="0,0,8,6"/>
                                <ComboBox x:Name="BurstCropCombo" Grid.Row="1" Grid.Column="1" Height="28" DisplayMemberPath="Name" SelectionChanged="BurstRoleCombo_SelectionChanged" Margin="0,0,8,6"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="보정(초)" Style="{StaticResource TinyLabel}" Margin="0,0,6,6" HorizontalAlignment="Right"/>
                                <TextBox x:Name="BurstTimingCorrectionBox" Grid.Row="1" Grid.Column="3" Height="28" Text="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" ToolTip="극딜 감지 지연 보정. 입력한 초만큼 실제 남은 시간에서 추가 차감합니다." LostFocus="BurstMonitorTextBox_LostFocus" KeyDown="BurstMonitorTextBox_KeyDown" Margin="0,0,0,6"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="오리진" Style="{StaticResource TinyLabel}" Margin="0,0,8,0"/>
                                <ComboBox x:Name="OriginBurstCropCombo" Grid.Row="2" Grid.Column="1" Height="28" DisplayMemberPath="Name" SelectionChanged="BurstRoleCombo_SelectionChanged" Margin="0,0,8,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="보정(초)" Style="{StaticResource TinyLabel}" Margin="0,0,6,0" HorizontalAlignment="Right"/>
                                <TextBox x:Name="OriginBurstTimingCorrectionBox" Grid.Row="2" Grid.Column="3" Height="28" Text="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" ToolTip="오리진 극딜 감지 지연 보정. 입력한 초만큼 실제 남은 시간에서 추가 차감합니다." LostFocus="BurstMonitorTextBox_LostFocus" KeyDown="BurstMonitorTextBox_KeyDown"/>
                            </Grid>

                            <Border BorderBrush="#b8cddd" BorderThickness="1" Background="#f5fbff" CornerRadius="6" Padding="8" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="사용 입력 보조" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBlock Text="등록한 스킬키가 메이플 창에서 눌리면 사용 후보를 즉시 만들고, 실제 아이콘이 사용 직후 상태로 바뀐 경우에만 쿨 사용으로 확정합니다. 키 입력만으로는 타이머를 시작하지 않습니다." Foreground="#566" TextWrapping="Wrap" Margin="0,0,0,7"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="62"/>
                                            <ColumnDefinition Width="56"/>
                                            <ColumnDefinition Width="78"/>
                                            <ColumnDefinition Width="58"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="준극딜" VerticalAlignment="Center" Margin="0,0,6,5"/>
                                        <TextBlock x:Name="SemiBurstTriggerKeyText" Grid.Row="0" Grid.Column="1" Text="미지정" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,5"/>
                                        <Button Grid.Row="0" Grid.Column="2" Content="키 등록" Tag="SemiBurst" Height="26" Click="BurstTriggerKeyRegister_Click" Margin="0,0,5,5"/>
                                        <Button Grid.Row="0" Grid.Column="3" Content="해제" Tag="SemiBurst" Height="26" Click="BurstTriggerKeyClear_Click" Margin="0,0,0,5"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="극딜" VerticalAlignment="Center" Margin="0,0,6,5"/>
                                        <TextBlock x:Name="BurstTriggerKeyText" Grid.Row="1" Grid.Column="1" Text="미지정" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,5"/>
                                        <Button Grid.Row="1" Grid.Column="2" Content="키 등록" Tag="Burst" Height="26" Click="BurstTriggerKeyRegister_Click" Margin="0,0,5,5"/>
                                        <Button Grid.Row="1" Grid.Column="3" Content="해제" Tag="Burst" Height="26" Click="BurstTriggerKeyClear_Click" Margin="0,0,0,5"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="오리진" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="OriginBurstTriggerKeyText" Grid.Row="2" Grid.Column="1" Text="미지정" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <Button Grid.Row="2" Grid.Column="2" Content="키 등록" Tag="OriginBurst" Height="26" Click="BurstTriggerKeyRegister_Click" Margin="0,0,5,0"/>
                                        <Button Grid.Row="2" Grid.Column="3" Content="해제" Tag="OriginBurst" Height="26" Click="BurstTriggerKeyClear_Click"/>
                                    </Grid>
                                    <TextBlock x:Name="BurstTriggerKeyCaptureHintText" Text="키 등록 버튼을 누른 뒤 이 창에서 실제 스킬키를 한 번 누르세요." Foreground="#678" TextWrapping="Wrap" Margin="0,7,0,0"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="스킬별 감지 학습" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock Text="① 스킬이 사용 가능한 상태에서 ‘준비 학습’  ② 스킬 사용 직후 ‘사용 직후 학습’. 두 상태가 모두 학습되기 전에는 감지하지 않습니다." Foreground="#566" TextWrapping="Wrap" Margin="0,0,0,8"/>

                            <Border BorderBrush="#ccd7df" BorderThickness="1" CornerRadius="6" Padding="7" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="준극딜" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="SemiBurstLearnStatusText" Grid.Row="0" Text="학습 안 됨" Foreground="#667" HorizontalAlignment="Right"/>
                                    <UniformGrid Grid.Row="1" Columns="3" Margin="0,6,0,0">
                                        <Button Content="준비 학습" Tag="SemiBurst|Ready" Style="{StaticResource SmallButton}" Click="BurstLearn_Click" Margin="0,0,4,0"/>
                                        <Button Content="사용 직후 학습" Tag="SemiBurst|Cooldown" Style="{StaticResource SmallButton}" Click="BurstLearn_Click" Margin="2,0"/>
                                        <Button Content="학습 삭제" Tag="SemiBurst" Style="{StaticResource SmallButton}" Click="BurstLearnClear_Click" Margin="4,0,0,0"/>
                                    </UniformGrid>
                                </Grid>
                            </Border>

                            <Border BorderBrush="#ccd7df" BorderThickness="1" CornerRadius="6" Padding="7" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="극딜" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="BurstLearnStatusText" Grid.Row="0" Text="학습 안 됨" Foreground="#667" HorizontalAlignment="Right"/>
                                    <UniformGrid Grid.Row="1" Columns="3" Margin="0,6,0,0">
                                        <Button Content="준비 학습" Tag="Burst|Ready" Style="{StaticResource SmallButton}" Click="BurstLearn_Click" Margin="0,0,4,0"/>
                                        <Button Content="사용 직후 학습" Tag="Burst|Cooldown" Style="{StaticResource SmallButton}" Click="BurstLearn_Click" Margin="2,0"/>
                                        <Button Content="학습 삭제" Tag="Burst" Style="{StaticResource SmallButton}" Click="BurstLearnClear_Click" Margin="4,0,0,0"/>
                                    </UniformGrid>
                                </Grid>
                            </Border>

                            <Border BorderBrush="#ccd7df" BorderThickness="1" CornerRadius="6" Padding="7" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="오리진" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="OriginBurstLearnStatusText" Grid.Row="0" Text="학습 안 됨" Foreground="#667" HorizontalAlignment="Right"/>
                                    <UniformGrid Grid.Row="1" Columns="3" Margin="0,6,0,0">
                                        <Button Content="준비 학습" Tag="OriginBurst|Ready" Style="{StaticResource SmallButton}" Click="BurstLearn_Click" Margin="0,0,4,0"/>
                                        <Button Content="사용 직후 학습" Tag="OriginBurst|Cooldown" Style="{StaticResource SmallButton}" Click="BurstLearn_Click" Margin="2,0"/>
                                        <Button Content="학습 삭제" Tag="OriginBurst" Style="{StaticResource SmallButton}" Click="BurstLearnClear_Click" Margin="4,0,0,0"/>
                                    </UniformGrid>
                                </Grid>
                            </Border>

                            <UniformGrid Columns="2" Margin="0,0,0,10">
                                <CheckBox x:Name="BurstMonitorVisibleCheck" Content="감지 PIP 표시" Style="{StaticResource OptionCheck}" ToolTip="준극딜/극딜/오리진 쿨 상태를 보여주는 별도 PIP를 표시합니다." Checked="BurstMonitorOptionChanged" Unchecked="BurstMonitorOptionChanged"/>
                            </UniformGrid>

                            <TextBlock Text="쿨타임 / 알림" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="쿨감 고정 초" Style="{StaticResource TinyLabel}" Margin="0,0,8,6"/>
                                <TextBox x:Name="BurstCooldownSecondsBox" Grid.Row="0" Grid.Column="1" Height="26" Text="0" VerticalContentAlignment="Center" ToolTip="쿨타임 감소 -n초" LostFocus="BurstMonitorTextBox_LostFocus" KeyDown="BurstMonitorTextBox_KeyDown" Margin="0,0,0,6"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="쿨감 퍼센트" Style="{StaticResource TinyLabel}" Margin="0,0,8,6"/>
                                <TextBox x:Name="BurstCooldownPercentBox" Grid.Row="1" Grid.Column="1" Height="26" Text="0" VerticalContentAlignment="Center" ToolTip="쿨타임 감소 n%" LostFocus="BurstMonitorTextBox_LostFocus" KeyDown="BurstMonitorTextBox_KeyDown" Margin="0,0,0,6"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="임박 (초 미만)" Style="{StaticResource TinyLabel}" Margin="0,0,8,0"/>
                                <TextBox x:Name="BurstWarningThresholdBox" Grid.Row="2" Grid.Column="1" Height="26" Text="5" VerticalContentAlignment="Center" ToolTip="남은 시간이 이 값보다 작을 때만 ‘임박’ 표시와 반짝임을 사용합니다. 0이면 임박 표시를 사실상 끕니다." LostFocus="BurstMonitorTextBox_LostFocus" KeyDown="BurstMonitorTextBox_KeyDown"/>
                            </Grid>

                            <TextBlock Text="감지 PIP 전체 투명도" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock x:Name="BurstMonitorOpacityText" Text="88%" Width="48" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <Slider x:Name="BurstMonitorOpacitySlider" Minimum="0.10" Maximum="1.0" Value="0.88" TickFrequency="0.05" SmallChange="0.01" LargeChange="0.05" IsSnapToTickEnabled="False" ValueChanged="BurstMonitorOpacitySlider_ValueChanged"
                                        ToolTip="감지 PIP의 글자/상태표시/배경을 포함한 전체 불투명도를 조절합니다."/>
                            </DockPanel>

                            <TextBlock Text="감지 PIP 배경 투명도" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock x:Name="BurstMonitorBackgroundOpacityText" Text="18%" Width="48" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <Slider x:Name="BurstMonitorBackgroundOpacitySlider" Minimum="0" Maximum="1.0" Value="0.18" TickFrequency="0.05" SmallChange="0.01" LargeChange="0.05" IsSnapToTickEnabled="False" ValueChanged="BurstMonitorBackgroundOpacitySlider_ValueChanged"
                                        ToolTip="감지 PIP의 바탕 배경만 투명하게 합니다. 0%는 완전 투명이고 글자와 상태 표시는 유지됩니다."/>
                            </DockPanel>

                            <Border Background="#fff8e8" BorderBrush="#e2c980" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,10">
                                <TextBlock Text="기본 쿨: 준극딜 60초 / 극딜 120초 / 오리진 360초&#x0a;임박은 위 설정값 미만에서만 표시됩니다." Foreground="#6d5b24" TextWrapping="Wrap"/>
                            </Border>

                            <WrapPanel>
                                <Button Content="상태 초기화" Width="88" Style="{StaticResource SmallButton}" Click="ResetBurstMonitor_Click" ToolTip="실시간 감지 상태와 내부 타이머만 초기화합니다. 학습 데이터는 유지됩니다."/>
                            </WrapPanel>
                            <TextBlock x:Name="BurstMonitorStatusText" Text="역할을 지정하고 감지 PIP를 표시하세요." Foreground="#567" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="필터키">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                                <TextBlock Text="필터키" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                <Border x:Name="FilterKeysStateBadge" Width="54" Height="24" CornerRadius="12" Background="#9b2c2c" BorderBrush="#6e1f1f" BorderThickness="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="FilterKeysStateBadgeText" Text="OFF" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <UniformGrid Columns="2" Margin="0,0,0,6">
                                <CheckBox x:Name="FilterKeysEnabledCheck" Content="사용" Style="{StaticResource OptionCheck}" ToolTip="현재 프리셋의 필터키 값을 Windows 필터 키에 적용합니다." Checked="FilterKeysOptionChanged" Unchecked="FilterKeysOptionChanged"/>
                                <CheckBox x:Name="FilterKeysMapleOnlyCheck" Content="메이플 활성 시만" Style="{StaticResource OptionCheck}" ToolTip="메이플스토리가 포커스일 때만 필터키를 켜고, 다른 창에서는 끕니다." Checked="FilterKeysOptionChanged" Unchecked="FilterKeysOptionChanged"/>
                                <CheckBox x:Name="FilterKeysTurnOffOnExitCheck" Content="종료 시 끄기" Style="{StaticResource OptionCheck}" ToolTip="프로그램 종료 시 필터키를 끕니다." Checked="FilterKeysOptionChanged" Unchecked="FilterKeysOptionChanged"/>
                                <CheckBox x:Name="FilterKeysPillVisibleCheck" Content="PIP 버튼" Style="{StaticResource OptionCheck}" ToolTip="작은 알약 모양 필터키 PIP 버튼을 띄웁니다." Checked="FilterKeysOptionChanged" Unchecked="FilterKeysOptionChanged"/>
                                <CheckBox x:Name="FilterKeysPillDragLockedCheck" Content="알약 위치 잠금" Style="{StaticResource OptionCheck}" ToolTip="알약 버튼을 눌러 ON/OFF 할 때 미세하게 움직이지 않도록 드래그 이동을 막습니다." Checked="FilterKeysOptionChanged" Unchecked="FilterKeysOptionChanged"/>
                            </UniformGrid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="입력 인식" Style="{StaticResource TinyLabel}" Margin="0,0,8,6"/>
                                <TextBox x:Name="FilterAcceptDelayBox" Grid.Row="0" Grid.Column="1" Height="26" Text="0" VerticalContentAlignment="Center" ToolTip="Accept Delay / iWaitMSec. 낮을수록 키 입력 인식이 빠릅니다." LostFocus="FilterKeysTextBox_LostFocus" KeyDown="FilterKeysTextBox_KeyDown" Margin="0,0,0,6"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="반복 대기" Style="{StaticResource TinyLabel}" Margin="0,0,8,6"/>
                                <TextBox x:Name="FilterRepeatDelayBox" Grid.Row="1" Grid.Column="1" Height="26" Text="250" VerticalContentAlignment="Center" ToolTip="Repeat Delay / iDelayMSec. 첫 반복 전 대기 시간입니다." LostFocus="FilterKeysTextBox_LostFocus" KeyDown="FilterKeysTextBox_KeyDown" Margin="0,0,0,6"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="반복 간격" Style="{StaticResource TinyLabel}" Margin="0,0,8,6"/>
                                <TextBox x:Name="FilterRepeatRateBox" Grid.Row="2" Grid.Column="1" Height="26" Text="25" VerticalContentAlignment="Center" ToolTip="Repeat Rate / iRepeatMSec. 키 반복 간격입니다." LostFocus="FilterKeysTextBox_LostFocus" KeyDown="FilterKeysTextBox_KeyDown" Margin="0,0,0,6"/>
                            </Grid>

                            <WrapPanel>
                                <Button Content="즉시 적용" Width="88" Style="{StaticResource SmallButton}" Click="ApplyFilterKeysNow_Click"/>
                                <Button Content="끄기" Width="56" Style="{StaticResource SmallButton}" Click="TurnOffFilterKeys_Click"/>
                            </WrapPanel>
                            <TextBlock x:Name="FilterKeysStatusText" Text="프리셋별로 저장됩니다." Foreground="#6b5178" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,10,0,0" Foreground="#444" Text="대상 창을 선택하고 크롭을 추가하세요." TextWrapping="Wrap"/>
    </Grid>
</Window>
