<Window x:Class="CropPipViewer.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crop PiP" Width="360" Height="220"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" MinWidth="80" MinHeight="60" ShowInTaskbar="False" Topmost="True"
        Focusable="True" PreviewKeyDown="Window_PreviewKeyDown">
    <Border x:Name="RootBorder" Background="#22000000" BorderBrush="#33FFFFFF" BorderThickness="0.6" CornerRadius="2" MouseLeftButtonDown="Root_MouseLeftButtonDown" MouseMove="Root_MouseMove" MouseLeftButtonUp="Root_MouseLeftButtonUp" MouseRightButtonDown="Root_MouseRightButtonDown">
        <Grid ClipToBounds="True" Background="#01000000">
            <Canvas x:Name="CanvasHost" ClipToBounds="True" Background="Transparent"/>
            <Border x:Name="PerformanceStatsBorder"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="4"
                    Padding="4,2"
                    CornerRadius="4"
                    Background="#99000000"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <TextBlock x:Name="PerformanceStatsText"
                           Text="FPS -- / --ms"
                           Foreground="#CCFFFFFF"
                           FontSize="10"
                           FontFamily="Consolas"/>
            </Border>
        </Grid>
    </Border>
</Window>
